# Copy to .env, chmod 600 .env, replace all CHANGE_ME values.
KMZ_ENV=production
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_60_CHARACTERS
POSTGRES_DB=kmz
POSTGRES_USER=kmz
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=db
ALLOWED_HOSTS=cards.example.com
PUBLIC_BASE_URL=https://cards.example.com
SERVICE_HOST=cards.example.com
# Ports are bound to loopback by default. Configure the company proxy/firewall
# before explicitly setting BIND_ADDRESS=0.0.0.0 for direct internet access.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
