limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=public_requests:10m rate=10r/s;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${SERVICE_HOST};
    return 308 https://${SERVICE_HOST}$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    return 444;
}
server {
    listen 443 ssl;
    server_name ${SERVICE_HOST};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 6m;
    add_header X-Robots-Tag 'noindex, nofollow, noarchive' always;

    location /static/ {
        alias /app/staticfiles/;
        add_header X-Content-Type-Options nosniff always;
    }
    location /private-media/ { return 404; }
    location = /manage/login/ {
        limit_req zone=admin_login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/kmz-proxy.conf;
    }
    location / {
        limit_req zone=public_requests burst=40 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/kmz-proxy.conf;
    }
}
